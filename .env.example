PORT=5000
MONGODB_URI=your_mongodb_connection_string
GEMINI_API_KEY=your_gemini_api_key
JWT_SECRET=your_jwt_secret

# One-time secret used to bootstrap the very first admin account via
# POST /api/admin/register-admin (sent as the "x-admin-setup-key" header).
# Once at least one admin exists, this key is no longer used — further
# admins must be created by an already-authenticated admin instead.
ADMIN_SETUP_KEY=your_admin_setup_key
